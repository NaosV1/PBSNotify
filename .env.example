# PBS Notify - Configuration Docker

# Clés VAPID pour les notifications push
# Générer avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# Secret JWT pour l'authentification
# Générer avec: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Port de l'application (optionnel, défaut: 3000)
PORT=3000

# Environnement Node.js (optionnel, défaut: production)
NODE_ENV=production

# Chemin de la base de données (géré automatiquement par Docker)
# DB_PATH=/app/backend/data
