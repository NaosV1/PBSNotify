# Server Configuration
PORT=3000

# VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# JWT Secret for authentication (generate with: openssl rand -hex 32)
# IMPORTANT: Use a strong random string (64+ characters)
JWT_SECRET=your_jwt_secret_here

# Note: The system only allows one administrator account
# Use ./reset-password.sh or node reset-password.js to reset password if forgotten
